{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  // dspy is a vendored upstream clone, not our code.
  "files": {
    "includes": ["!dspy", "!gepa"]
  },
  "linter": {
    "rules": {
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" }
        }
      }
    }
  },
  // src/index.ts is the package entrypoint, so it is a barrel file by design.
  "overrides": [
    {
      "includes": ["src/index.ts"],
      "linter": { "rules": { "performance": { "noBarrelFile": "off" } } }
    }
  ],
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    }
  }
}
